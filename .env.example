# Optional. Copy to .env to override defaults; `docker compose up --build` works without it.
# For running the api outside Docker, the same variables apply (see api/src/config.ts).

# Product data source: "fakestore" (live https://fakestoreapi.com) or "fixture" (bundled snapshot, works offline)
PRODUCT_SOURCE=fakestore
FAKESTORE_BASE_URL=https://fakestoreapi.com
# How long product data is cached in the api, in seconds
CATALOG_CACHE_TTL_SECONDS=300

# Email (defaults deliver to the local Mailpit inbox at http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
# Leave blank for Mailpit. For a real provider, set these in .env only - never commit them.
SMTP_USER=
SMTP_PASS=
MAIL_FROM=catalogue@example.com
SALES_INBOX_EMAIL=sales@example.com

# api only (outside Docker): port and featured-products file, relative to api/
# PORT=3001
# FEATURED_CONFIG_PATH=config/featured.json
